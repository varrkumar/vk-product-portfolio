<style>
/* ─── Global overrides for this page ───────────────────────────────────── */
.pg p { max-width: none; margin: 0; }
.pg p + p { margin-top: 0; }
.pg a { text-decoration: none; }
.pg img { display: block; max-width: 100%; }

/* ─── Notebook sidebar ─────────────────────────────────────────────────── */
.nb {
  flex: 1 1 300px;
  max-width: 372px;
  display: flex;
  flex-direction: column;
}
@media (min-width: 900px) {
  .nb { position: sticky; top: 12px; }
}

.tabs {
  display: flex;
  align-items: flex-end;
  gap: 5px;
  padding-left: 52px;
  height: 46px;
  position: relative;
  z-index: 2;
}
.tab {
  position: relative;
  display: flex;
  align-items: center;
  height: 40px;
  padding: 2px 18px 0;
  border-radius: 12px 12px 0 0;
  background: #F3F2EF;
  box-shadow: inset 0 1px 0 #ECEAE5, inset 1px 0 0 #ECEAE5, inset -1px 0 0 #ECEAE5;
  font: 400 21px/1 'Kalam', cursive;
  color: #7A766D;
  text-decoration: none;
  transition: color .3s, background .3s;
}
.tab:hover { color: #1C1B18; }
.tab.cur {
  height: 46px;
  background: #fff;
  color: #2D45B8;
  transform: none;
  margin-bottom: -1px;
}
.tab:focus-visible { outline: 2px solid #2D45B8; outline-offset: 2px; }

.sb {
  position: relative;
  min-height: 812px;
  border-radius: 18px;
  padding: 64px 30px 24px 62px;
  display: flex;
  flex-direction: column;
  background-color: #fff;
  background-image: repeating-linear-gradient(
    to bottom,
    transparent 0, transparent 31px,
    rgba(45,69,184,.1) 31px, rgba(45,69,184,.1) 32px
  );
  box-shadow: inset 0 0 0 1px #ECEAE5;
}
.sb::before {
  content: "";
  position: absolute;
  left: 40px; top: 0; bottom: 0;
  border-left: 1px solid rgba(45,69,184,.3);
}
.sb::after {
  content: "";
  position: absolute;
  left: 44px; top: 0; bottom: 0;
  border-left: 1px solid rgba(45,69,184,.14);
}

.sbn {
  position: relative;
  font-weight: 400;
  font-size: 40px;
  line-height: 32px;
  letter-spacing: -.02em;
  margin: 0;
  padding-top: 12px;
  font-family: 'Newsreader Variable', Newsreader, Georgia, serif;
}
.ta {
  position: absolute;
  left: .06em; top: -.6em;
  font-family: 'Noto Serif Tamil', serif;
  font-size: .4em;
  color: #A9B6F7;
  letter-spacing: 0;
  clip-path: inset(-30% 100% -30% 0);
  transition: clip-path 1s cubic-bezier(.6,.05,.35,1);
  pointer-events: none;
}
.sbn:hover .ta { clip-path: inset(-30% 0 -30% 0); }

.uline {
  display: block;
  width: 62%;
  height: 16px;
  margin-top: 10px;
  overflow: visible;
}
.uline path {
  fill: none;
  stroke: #A9B6F7;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-dasharray: 1;
  stroke-dashoffset: 1;
  animation: drawin 1.6s cubic-bezier(.6,.05,.35,1) .5s forwards;
}
@keyframes drawin { to { stroke-dashoffset: 0; } }

.typ {
  font-size: 18px;
  line-height: 32px;
  color: #5F5B53;
  margin: 32px 0 0;
  font-family: 'Newsreader Variable', Newsreader, Georgia, serif;
}
.hw {
  font: 400 21px/32px 'Kalam', cursive;
  color: #2D45B8;
  margin: 0;
}
.sfoot { margin-top: auto; padding-top: 32px; }
.now { font-size: 19px; }
.open { margin: 0; color: #1C1B18; }
.lnk {
  display: flex;
  flex-wrap: wrap;
  column-gap: 18px;
  margin: 0;
  font: 500 10px/32px 'IBM Plex Mono', monospace;
  letter-spacing: .14em;
  text-transform: uppercase;
}
.lnk a {
  color: #1C1B18;
  text-decoration: underline;
  text-decoration-color: rgba(45,69,184,.4);
  text-underline-offset: 4px;
}
.lnk a:hover { text-decoration-color: #2D45B8; }
.clk { color: #8A867D; }

/* ─── Cards ────────────────────────────────────────────────────────────── */
.cv {
  position: relative;
  display: flex;
  flex-direction: column;
  border-radius: 18px;
  overflow: hidden;
  container-type: inline-size;
  text-decoration: none;
  aspect-ratio: 1.12 / 1;
  isolation: isolate;
}
.cv:focus-visible { outline: 2px solid #2D45B8; outline-offset: 3px; }

.art {
  position: relative;
  flex: 1 1 auto;
  overflow: hidden;
  min-height: 0;
}
.lift {
  position: absolute;
  inset: 0;
  transition: transform 1.4s cubic-bezier(.2,.7,.2,1);
}
.cv:hover .lift { transform: scale(1.03); }

.cap {
  position: relative;
  padding: 2.6cqw 4cqw 3.6cqw;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 3cqw;
}
.meta {
  font: 500 max(10px, 1.32cqw) / 1.2 'IBM Plex Mono', monospace;
  letter-spacing: .14em;
  text-transform: uppercase;
  margin: 0;
  opacity: .82;
}
.ttl {
  font-weight: 400;
  font-size: max(28px, 5.3cqw);
  line-height: 1;
  letter-spacing: -.02em;
  margin: 1.1cqw 0 0;
  font-family: 'Newsreader Variable', Newsreader, Georgia, serif;
}
.ask {
  margin: 1.5cqw 0 0;
  font-size: max(14px, 2cqw);
  line-height: 1.3;
  min-height: 2.7em;
  font-family: 'Newsreader Variable', Newsreader, Georgia, serif;
}
.ask .lb {
  font: 500 max(9px, 1.15cqw) / 1 'IBM Plex Mono', monospace;
  letter-spacing: .12em;
  text-transform: uppercase;
  opacity: .75;
  margin-right: .7em;
  vertical-align: .12em;
}
.old {
  position: relative;
  opacity: .78;
  white-space: nowrap;
}
.old svg {
  position: absolute;
  left: -3%; top: 44%;
  width: 106%; height: .55em;
  overflow: visible;
}
.old path {
  fill: none;
  stroke: #2D45B8;
  stroke-width: 2.6;
  stroke-linecap: round;
  stroke-dasharray: 1;
  stroke-dashoffset: 1;
  transition: stroke-dashoffset .55s cubic-bezier(.6,.05,.35,1);
}
.new {
  display: block;
  font-family: 'Kalam', cursive;
  color: #2D45B8;
  font-size: 1.1em;
  line-height: 1.25;
  clip-path: inset(-30% 100% -30% 0);
  transition: clip-path 1.05s cubic-bezier(.6,.05,.35,1) .35s;
}
.cv:hover .old path,
.cv:focus-visible .old path { stroke-dashoffset: 0; }
.cv:hover .new,
.cv:focus-visible .new { clip-path: inset(-30% 0 -30% 0); }

.go {
  flex: none;
  width: max(44px, 6.2cqw);
  height: max(44px, 6.2cqw);
  border-radius: 50%;
  border: 1.5px solid currentColor;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .45s, transform .6s cubic-bezier(.6,.05,.35,1);
}
.go svg { width: 38%; height: 38%; color: currentColor; transition: color .45s; }
.cv:hover .go { background: currentColor; transform: rotate(-45deg); }
.cv:hover .go svg { color: var(--t); }

/* no-hover: show static states */
@media (hover: none) {
  .old path { stroke-dashoffset: 0; }
  .new { clip-path: none; }
}

/* ─── Short entries (smaller cards) ───────────────────────────────────── */
.sm { aspect-ratio: .92 / 1; }
.sm .ttl { font-size: max(24px, 6.4cqw); }
.one {
  margin: 1.4cqw 0 0;
  font-size: max(14px, 3cqw);
  line-height: 1.3;
  opacity: .85;
  font-family: 'Newsreader Variable', Newsreader, Georgia, serif;
}
.sm .meta { font-size: max(10px, 1.9cqw); }
.sm .go { width: max(40px, 9cqw); height: max(40px, 9cqw); }

/* ─── Biomotivate artwork ──────────────────────────────────────────────── */
.brains {
  position: absolute;
  inset: -12%;
  opacity: .42;
  mix-blend-mode: multiply;
  animation: drift 38s ease-in-out infinite alternate;
}
.brains img { width: 100%; height: 100%; object-fit: cover; }
@keyframes drift {
  from { transform: translate(0,0) scale(1.05); }
  to { transform: translate(-7%,-5%) scale(1.12); }
}
.bw {
  position: absolute;
  left: 6%; right: 7%; top: 9%;
  background: #fff;
  border-radius: 1.1cqw;
  overflow: hidden;
  box-shadow: 0 2.4cqw 5cqw -1.6cqw rgba(110,40,20,.45), 0 0 0 1px rgba(110,40,20,.08);
}
.bbar {
  display: flex;
  align-items: center;
  gap: .5cqw;
  height: 2.2cqw;
  padding: 0 1cqw;
  background: #F4F1EE;
}
.bbar i {
  display: block;
  width: .75cqw; height: .75cqw;
  border-radius: 50%;
  background: #DDD6D0;
}
.bbar span {
  margin-left: 1cqw;
  font: 500 max(9px, .85cqw) / 1 'IBM Plex Mono', monospace;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: #8A7F78;
}
.bscr {
  position: relative;
  aspect-ratio: 1300 / 805;
}
.bscr img {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
}
.bscr .af {
  clip-path: inset(0 0 0 100%);
  animation: wipe2 10s cubic-bezier(.7,0,.3,1) infinite;
}
@keyframes wipe2 {
  0%,16% { clip-path: inset(0 0 0 100%); }
  36%,78% { clip-path: inset(0 0 0 0); }
  96%,100% { clip-path: inset(0 0 0 100%); }
}
.wipe {
  position: absolute;
  top: 0; bottom: 0;
  left: 100%;
  width: 2px;
  background: #2D45B8;
  animation: wline 10s cubic-bezier(.7,0,.3,1) infinite;
}
@keyframes wline {
  0%,16% { left: 100%; }
  36%,78% { left: 0%; }
  96%,100% { left: 100%; }
}
.wipe b {
  position: absolute;
  top: 50%; left: 50%;
  width: 3cqw; height: 3cqw;
  margin: -1.5cqw;
  border-radius: 50%;
  background: #fff;
  border: 2px solid #2D45B8;
  box-shadow: 0 .6cqw 1.6cqw rgba(45,69,184,.35);
}
.ba {
  position: absolute;
  right: 7%; top: 3.2%;
  margin: 0;
  display: grid;
  font: 400 max(14px, 1.7cqw) / 1 'Kalam', cursive;
  color: #2D45B8;
}
.ba span { grid-area: 1/1; text-align: right; }
.ba .l1 { animation: lb1 10s infinite; }
.ba .l2 { opacity: 0; animation: lb2 10s infinite; }
@keyframes lb1 { 0%,22% { opacity:1; } 28%,88% { opacity:0; } 94%,100% { opacity:1; } }
@keyframes lb2 { 0%,24% { opacity:0; } 30%,84% { opacity:1; } 90%,100% { opacity:0; } }

/* ─── AI CoE artwork ───────────────────────────────────────────────────── */
#aicoe .art {
  background-image:
    linear-gradient(rgba(45,69,184,.07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(45,69,184,.07) 1px, transparent 1px);
  background-size: 2.2cqw 2.2cqw;
}
.scA, .scB { position: absolute; inset: 0; }
.scA { animation: scA 16s ease infinite; }
.scB { opacity: 0; animation: scB 16s ease infinite; }
@keyframes scA {
  0%,44% { opacity:1; transform:none; }
  50%,94% { opacity:0; transform:translateY(-2%); }
  100% { opacity:1; transform:none; }
}
@keyframes scB {
  0%,46% { opacity:0; transform:translateY(2%); }
  52%,94% { opacity:1; transform:none; }
  99%,100% { opacity:0; }
}
.frm {
  position: absolute;
  left: 6%; top: 9%; width: 32%; height: 72%;
  background: #fff;
  border-radius: 1.2cqw;
  padding: 2cqw;
  box-shadow: 0 1.6cqw 3.6cqw -1.6cqw rgba(23,42,64,.35);
  overflow: hidden;
}
.frm .fl {
  margin: 0 0 1.2cqw;
  font: 500 max(8px, 1.15cqw) / 1 'IBM Plex Mono', monospace;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #5C7FA8;
}
.frm i {
  display: block;
  height: 2.6cqw;
  border: 1px solid #D5DDE8;
  border-radius: .6cqw;
  margin-bottom: 1.1cqw;
  position: relative;
  animation: fin 16s ease infinite both;
}
.frm i::before {
  content: "";
  position: absolute;
  left: 0; top: -.9cqw;
  width: 40%; height: .5cqw;
  border-radius: 99px;
  background: #E1E7F0;
}
.frm i:nth-of-type(2) { animation-delay: .1s; }
.frm i:nth-of-type(3) { animation-delay: .2s; }
.frm i:nth-of-type(4) { animation-delay: .3s; }
.frm i:nth-of-type(5) { animation-delay: .4s; }
.frm i:nth-of-type(6) { animation-delay: .5s; }
.frm i:nth-of-type(7) { animation-delay: .6s; }
.frm i:nth-of-type(8) { animation-delay: .7s; }
@keyframes fin {
  0%,2% { opacity:0; transform:translateY(.8cqw); }
  6%,100% { opacity:1; transform:none; }
}
.xo {
  position: absolute;
  inset: 6%;
  width: 88%; height: 88%;
  overflow: visible;
}
.xo path {
  fill: none;
  stroke: #2D45B8;
  stroke-width: 2.4;
  stroke-linecap: round;
  stroke-dasharray: 1;
  stroke-dashoffset: 1;
  animation: xo 16s cubic-bezier(.6,.05,.35,1) infinite;
}
.xo path + path { animation-name: xo2; }
@keyframes xo { 0%,11% { stroke-dashoffset:1; } 15%,100% { stroke-dashoffset:0; } }
@keyframes xo2 { 0%,14% { stroke-dashoffset:1; } 18%,100% { stroke-dashoffset:0; } }
.harr {
  position: absolute;
  left: 39.5%; top: 38%;
  width: 8%;
  overflow: visible;
}
.harr path {
  fill: none;
  stroke: #2D45B8;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-dasharray: 1;
  stroke-dashoffset: 1;
  animation: xo 16s ease infinite;
  animation-delay: .6s;
}
.chat {
  position: absolute;
  left: 49%; right: 5%; top: 9%;
  display: flex;
  flex-direction: column;
  gap: 1.3cqw;
  font: 400 max(9px, 1.45cqw) / 1.35 'Inter', system-ui, sans-serif;
}
.cb {
  margin: 0;
  padding: 1.3cqw 1.6cqw;
  border-radius: 1.4cqw;
  max-width: 92%;
}
.cb.me {
  align-self: flex-end;
  background: #3A5A80;
  color: #fff;
  border-bottom-right-radius: .3cqw;
  animation: cin 16s ease infinite both;
  animation-delay: 2.9s;
}
.cb.ai {
  background: #fff;
  color: #172A40;
  border-bottom-left-radius: .3cqw;
  box-shadow: 0 0 0 1px #D5DDE8;
  animation: cin 16s ease infinite both;
  animation-delay: 3.7s;
}
@keyframes cin {
  0% { opacity:0; transform:translateY(1cqw); }
  4%,40% { opacity:1; transform:none; }
  100% { opacity:1; }
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: .8cqw;
}
.chips span {
  padding: .6cqw 1.2cqw;
  border-radius: 99px;
  background: #E6ECF5;
  color: #3A5A80;
  font-weight: 500;
  animation: cin 16s ease infinite both;
}
.chips span:nth-child(1) { animation-delay: 4.5s; }
.chips span:nth-child(2) { animation-delay: 4.8s; }
.chips span:nth-child(3) { animation-delay: 5.1s; }
.cite {
  margin: 0;
  align-self: flex-start;
  font: 500 max(8px, 1.15cqw) / 1 'IBM Plex Mono', monospace;
  letter-spacing: .06em;
  color: #2D45B8;
  border: 1px dashed rgba(45,69,184,.5);
  padding: .7cqw 1.1cqw;
  border-radius: .6cqw;
  animation: cin 16s ease infinite both;
  animation-delay: 5.6s;
}
.sl2 {
  position: absolute;
  left: 49%; bottom: 16%;
  margin: 0;
  font: 400 max(12px, 1.9cqw) / 1.1 'Kalam', cursive;
  color: #2D45B8;
  animation: cin 16s ease infinite both;
  animation-delay: 6s;
}
.scB { padding: 7% 6% 0; }
.bh {
  margin: 0 0 2.2cqw;
  font: 500 max(9px, 1.2cqw) / 1 'IBM Plex Mono', monospace;
  letter-spacing: .12em;
  text-transform: uppercase;
  opacity: .8;
}
.bl {
  display: grid;
  grid-template-columns: 34% 1fr 9%;
  align-items: center;
  gap: 1.6cqw;
  margin-bottom: 1.5cqw;
  font-size: max(11px, 1.6cqw);
  font-family: 'IBM Plex Mono', monospace;
}
.bl i {
  display: block;
  height: 2.2cqw;
  width: var(--w);
  border-radius: 99px;
  background: rgba(23,42,64,.22);
  transform-origin: left;
  animation: bgrow 16s cubic-bezier(.2,.7,.2,1) infinite;
}
.bl b { font-weight: 400; font-variant-numeric: tabular-nums; }
.bl.top i { background: #2D45B8; }
.bl.top b { position: relative; }
.bl.top b::after {
  content: "";
  position: absolute;
  inset: -.7cqw -1cqw;
  border: 1.6px solid #2D45B8;
  border-radius: 50%;
  transform: rotate(-6deg);
  clip-path: inset(0 100% 0 0);
  animation: ring2 16s cubic-bezier(.6,.05,.35,1) infinite;
}
@keyframes ring2 { 0%,60% { clip-path:inset(0 100% 0 0); } 66%,100% { clip-path:inset(0 0 0 0); } }
.bl:nth-of-type(2) i { animation-delay: .08s; }
.bl:nth-of-type(3) i { animation-delay: .16s; }
.bl:nth-of-type(4) i { animation-delay: .24s; }
.bl:nth-of-type(5) i { animation-delay: .32s; }
.bl:nth-of-type(6) i { animation-delay: .40s; }
@keyframes bgrow { 0%,50% { transform:scaleX(0); } 58%,100% { transform:scaleX(1); } }
.bf {
  margin: 2.4cqw 0 0;
  font: 500 max(9px, 1.2cqw) / 1 'IBM Plex Mono', monospace;
  letter-spacing: .12em;
  text-transform: uppercase;
  opacity: .75;
}
.bn {
  position: absolute;
  right: 6%; top: 6%;
  margin: 0;
  font: 400 max(12px, 2cqw) / 1 'Kalam', cursive;
  color: #2D45B8;
  transform: rotate(-3deg);
}
.aicoe-note {
  position: absolute;
  left: 5.5%; bottom: 5%;
  font: 400 max(12px, 1.9cqw) / 1 'Kalam', cursive;
  color: #2D45B8;
}

/* ─── WorkBench artwork ────────────────────────────────────────────────── */
.mpat {
  position: absolute;
  left: -12%; top: -12%;
  width: 124%; height: 124%;
  opacity: .16;
  animation: mp 16s linear infinite;
}
@keyframes mp { from { transform: translate(0,0); } to { transform: translate(-10%,-10%); } }
.deck {
  position: absolute;
  left: 13%; right: 13%; top: 18%;
  aspect-ratio: 1.4 / 1;
}
.dk {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  border-radius: 1.4cqw;
  box-shadow: 0 2.6cqw 5cqw -1.4cqw rgba(0,0,0,.6);
  animation: deck 12s cubic-bezier(.65,0,.35,1) infinite both;
}
@keyframes deck {
  0%,26%  { transform:translateY(0) scale(1); opacity:1; z-index:3; }
  33%     { transform:translateY(14%) scale(1.02); opacity:0; z-index:3; }
  34%     { transform:translateY(-14%) scale(.86); opacity:0; z-index:1; }
  40%,59% { transform:translateY(-14%) scale(.86); opacity:.45; z-index:1; }
  66%,92% { transform:translateY(-7%) scale(.93); opacity:.75; z-index:2; }
  100%    { transform:translateY(0) scale(1); opacity:1; z-index:3; }
}
.wbn {
  position: absolute;
  left: 6%; top: 4.5%;
  margin: 0;
  font: 400 max(13px, 2.3cqw) / 1 'Kalam', cursive;
  color: #8FE3B0;
}

/* ─── Halo artwork ─────────────────────────────────────────────────────── */
.hwin {
  position: absolute;
  left: 39%; right: 4%; top: 15%;
  aspect-ratio: 1.45 / 1;
  background: #fff;
  border-radius: 1.4cqw;
  overflow: hidden;
  box-shadow: 0 2.4cqw 5cqw -1.6cqw rgba(42,32,104,.4), 0 0 0 1px rgba(42,32,104,.08);
}
.hwin img {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: 0% 0%;
  transform-origin: 20% 25%;
}
.hwin .k1 { animation: kb1 14s ease-in-out infinite; }
.hwin .k2 { opacity: 0; transform-origin: 70% 75%; animation: kb2 14s ease-in-out infinite; }
@keyframes kb1 {
  0%  { opacity:1; transform:scale(1.02); }
  44% { opacity:1; transform:scale(1.38); }
  50%,96% { opacity:0; transform:scale(1.38); }
  100% { opacity:1; transform:scale(1.02); }
}
@keyframes kb2 {
  0%,44% { opacity:0; transform:scale(1.02); }
  50%  { opacity:1; transform:scale(1.04); }
  94%  { opacity:1; transform:scale(1.4); }
  100% { opacity:0; transform:scale(1.4); }
}
.mascot {
  position: absolute;
  left: 0; bottom: 6%;
  width: 40%;
  animation: bob 4.2s ease-in-out infinite;
  z-index: 2;
}
@keyframes bob {
  0%,100% { transform: translateY(0) rotate(-1.5deg); }
  50%     { transform: translateY(-6%) rotate(1.5deg); }
}
.mshadow {
  position: absolute;
  left: 11%; bottom: 5%;
  width: 18%; height: 2.4%;
  border-radius: 50%;
  background: rgba(42,32,104,.18);
  filter: blur(3px);
  animation: shd 4.2s ease-in-out infinite;
}
@keyframes shd {
  0%,100% { transform:scaleX(1); opacity:.9; }
  50%     { transform:scaleX(.75); opacity:.5; }
}
.spk {
  position: absolute;
  width: 3.4cqw; height: 3.4cqw;
  background: #B9A6F2;
  clip-path: polygon(50% 0,61% 39%,100% 50%,61% 61%,50% 100%,39% 61%,0 50%,39% 39%);
  animation: tw 2.8s ease-in-out infinite;
  z-index: 3;
}
@keyframes tw {
  0%,100% { opacity:.25; scale:.6; }
  50%     { opacity:1; scale:1; }
}
.hn {
  position: absolute;
  right: 4%; bottom: 4%;
  margin: 0;
  font: 400 max(13px, 2.2cqw) / 1 'Kalam', cursive;
  color: #2D45B8;
}

/* ─── GOTR artwork ─────────────────────────────────────────────────────── */
.pst {
  position: absolute;
  margin: 0;
  padding: 1cqw;
  background: #fff;
  box-shadow: 0 1.6cqw 3.6cqw -1.2cqw rgba(94,58,5,.45);
  animation: lift 9s cubic-bezier(.45,0,.55,1) infinite;
}
.pst img { display: block; height: 100%; width: auto; }
.p1 { left: 4%; top: 8%; height: 86%; --r: -5deg; transform: rotate(-5deg); }
.p2 { left: 27%; top: 5%; height: 90%; --r: 3deg; transform: rotate(3deg); animation-delay: -4.5s; }
@keyframes lift {
  0%,40%,100% { transform:rotate(var(--r)) translateY(0); box-shadow:0 1.6cqw 3.6cqw -1.2cqw rgba(94,58,5,.45); z-index:1; }
  50%,90%     { transform:rotate(0deg) translateY(-3%) scale(1.03); box-shadow:0 3.4cqw 6cqw -1.6cqw rgba(94,58,5,.55); z-index:2; }
}
.tape {
  position: absolute;
  left: 50%; top: -1cqw;
  width: 6cqw; height: 2cqw;
  margin-left: -3cqw;
  background: rgba(255,255,255,.62);
  box-shadow: 0 0 0 1px rgba(94,58,5,.06);
  transform: rotate(-4deg);
}
.stk {
  position: absolute;
  right: 4%; bottom: 7%;
  width: 21%;
  margin: 0;
  transform-origin: 50% 0;
  animation: flut 3.6s ease-in-out infinite alternate;
  box-shadow: 0 1.4cqw 2.6cqw -1cqw rgba(0,0,0,.3);
  z-index: 3;
}
.stk img { display: block; width: 100%; }
.stk .tape { width: 7cqw; margin-left: -3.5cqw; top: -1.4cqw; }
@keyframes flut {
  from { transform: rotate(7deg); }
  to   { transform: rotate(3.5deg) translateY(-1%); }
}
.gn {
  position: absolute;
  right: 4%; top: 7%;
  margin: 0;
  font: 400 max(13px, 1.6cqw) / 1.1 'Kalam', cursive;
  color: #2D45B8;
  text-align: right;
  z-index: 3;
}
.gn svg {
  display: block;
  width: 4cqw; height: 3cqw;
  margin: .6cqw 0 0 auto;
  overflow: visible;
  transform: rotate(60deg);
}
.gn path { fill:none; stroke:#2D45B8; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }

/* ─── Sous artwork ─────────────────────────────────────────────────────── */
.eyes {
  position: absolute;
  left: 50%; top: 38%;
  transform: translate(-50%,-50%);
  display: flex;
  gap: 5cqw;
}
.eye {
