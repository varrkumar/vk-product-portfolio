<script is:inline>
  /* Local Pittsburgh time */
  (function () {
    const el = document.getElementById('local-time');
    if (!el) return;
    function tick() {
      const time = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/New_York',
        hour: 'numeric',
        minute: '2-digit',
        hour12: true,
      }).format(new Date());
      el.textContent = 'Pittsburgh · ' + time;
    }
    tick();
    setInterval(tick, 30000);
  })();
</script>
