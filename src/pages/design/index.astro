---
import Base from '../../layouts/Base.astro';
import CaseStudyHeader from '../../components/notebook/CaseStudyHeader.astro';
import { Image } from 'astro:assets';

import dscImg  from '../../assets/data-science-club/mascot-agents.png';
import wipImg  from '../../assets/women-in-product/logo-brand.png';
import echosImg from '../../assets/echos/hackathon-prototype.png';

const entries = [
  {
    slug: 'data-science-club',
    title: 'Data Science Club',
    context: 'CMU',
    year: '2023–25',
    summary: 'Brand identity, event graphics, Poker AI site.',
    img: dscImg,
    imgAlt: 'Blue sprout-robot mascot for the DSC AI Agents Weekend competition.',
  },
  {
    slug: 'women-in-product',
    title: 'Women in Product',
    context: 'CMU',
    year: '2025–26',
    summary: 'Logo, brand system, social, website.',
    img: wipImg,
    imgAlt: 'WiP circular badge logo on purple with brand guide.',
  },
  {
    slug: 'echos',
    title: 'echos',
    context: 'XHacks → independent',
    year: '2024–',
    summary: 'Voice-based location-based social app.',
    img: echosImg,
    imgAlt: 'Hackathon prototype overview: splash screen, map view, record screen, and four listening modes.',
  },
];
---

<Base title="Design · VK">
  <div style="background: var(--paper); min-height: 100vh; color: var(--ink); padding-bottom: 120px">

    <CaseStudyHeader entryNum="" />

    <div class="cs-row" style="padding-top: 56px; padding-bottom: 40px">
      <div></div>
      <div>
        <p class="page-eyebrow mono">Design</p>
        <h1 class="page-title">Visual design and brand</h1>
      </div>
    </div>

    <div class="cs-row">
      <div></div>
      <ul class="design-gallery cs-wide" role="list">
        {entries.map(entry => (
          <li class="gallery-item">
            <a href={`/design/${entry.slug}`} class="gallery-link" aria-label={entry.title}>
              <div class="gallery-img-wrap frame-wrap">
                <Image
                  src={entry.img}
                  alt={entry.imgAlt}
                  widths={[400, 800]}
                  sizes="(max-width: 1000px) 90vw, 300px"
                  class="gallery-img"
                />
              </div>
              <div class="gallery-meta">
                <span class="gallery-title">{entry.title}</span>
                <span class="gallery-context mono">{entry.context} · {entry.year}</span>
              </div>
              <p class="gallery-summary">{entry.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <footer class="cs-row" style="padding-top: 48px; align-items: end">
      <div></div>
      <a href="/" class="back mono">← Home</a>
    </footer>

  </div>
</Base>

<style>
  .page-eyebrow {
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--ink-40);
    margin: 0 0 10px;
    max-width: none;
  }
  .page-title {
    font-family: var(--font-serif);
    font-size: 36px;
    font-variation-settings: 'opsz' 36, 'wght' 400;
    font-style: italic;
    line-height: 1.15;
    letter-spacing: -0.015em;
    max-width: none;
  }

  /* Gallery grid */
  .design-gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 32px;
  }
  .gallery-item { display: block; }
  .gallery-link {
    display: block;
    text-decoration: none;
    color: var(--ink);
  }
  .gallery-img-wrap {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    margin-bottom: 14px;
  }
  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .gallery-link:hover .gallery-img {
    transform: scale(1.02);
  }
  .gallery-meta {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }
  .gallery-title {
    font-family: var(--font-serif);
    font-size: 18px;
    font-variation-settings: 'opsz' 18, 'wght' 400;
    line-height: 1.2;
  }
  .gallery-context {
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--ink-40);
  }
  .gallery-summary {
    font-family: var(--font-serif);
    font-size: 13px;
    font-variation-settings: 'opsz' 13, 'wght' 400;
    line-height: 1.5;
    color: var(--ink-60);
    margin: 0;
    max-width: none;
  }

  .back { color: var(--ink-60); text-decoration: none; font-size: 13px; }
  .back:hover { color: var(--ink); }

  @media (max-width: 1000px) {
    .design-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; }
    .page-title { font-size: 28px; }
  }
  @media (max-width: 600px) {
    .design-gallery { grid-template-columns: minmax(0, 1fr); }
  }
</style>
