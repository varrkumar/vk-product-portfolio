---
import Base from '../layouts/Base.astro';
import CaseStudyHeader from '../components/notebook/CaseStudyHeader.astro';
import HeroReframe from '../components/notebook/HeroReframe.astro';
import SectionRow from '../components/notebook/SectionRow.astro';
import InsightLine from '../components/notebook/InsightLine.astro';
import Versions from '../components/notebook/Versions.astro';
import OutcomeStats from '../components/notebook/OutcomeStats.astro';
import Reflection from '../components/notebook/Reflection.astro';
import Tally from '../components/notebook/Tally.astro';
import Annotate from '../components/notebook/Annotate.astro';
import Fork from '../components/notebook/Fork.astro';
---

<Base title="Case study — Lab Notebook sharing · VK">
  <div style="background: var(--paper); min-height: 100vh; color: var(--ink); padding-bottom: 120px">

    <CaseStudyHeader entryNum="03" />

    <HeroReframe
      original="Why is the sharing interface confusing?"
      reframed="Why won't scientists share an idea before it's finished?"
      entryNum="03"
      marginNote="Lead product designer. 14 weeks, spring 2024. Two engineers, one researcher, & a very patient PM."
      marginSub="(this reframe is the whole story. everything below is how I got here.)"
    />

    <!-- 01 brief -->
    <SectionRow num="01" label="the brief" pb="88px">
      <Fragment slot="main">
        <p style="font-size:21px;line-height:1.62;margin:0 0 22px;font-family:var(--font-serif)">
          Lab Notebook is a research tool used by about 400 scientists. Its sharing feature was barely used: people opened the share dialog
          <Annotate type="circle">1.2 times</Annotate>
          on average, then closed it without sending anything.
        </p>
        <p style="font-size:21px;line-height:1.62;margin:0;font-family:var(--font-serif)">The hypothesis I was given: the interface is confusing. Fix the dialog.</p>
      </Fragment>
      <Fragment slot="margin">
        <div style="display:flex;gap:8px;align-items:flex-start;transform:rotate(-0.8deg)">
          <svg aria-hidden="true" width="26" height="16" viewBox="0 0 26 16" style="flex:none;margin-top:8px">
            <path d="M25,8 C 18,9 10,7 3,8 M8,3 C 6,5 4,7 2,8 C 4,9 6,11 8,13" fill="none" stroke="#2D45B8" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
          <span style="font-family:var(--font-hand);font-weight:300;color:var(--pencil);font-size:19px;line-height:1.45">Opening it and closing it isn't confusion. Confused people file tickets. We had almost none.</span>
        </div>
      </Fragment>
    </SectionRow>

    <!-- 02 research -->
    <SectionRow num="02" label="listening" pb="40px">
      <Fragment slot="main">
        <p style="font-size:21px;line-height:1.62;margin:0;font-family:var(--font-serif)">I ran six contextual interviews, sitting beside researchers while they worked. Nobody struggled with the dialog. They understood it fine. They just didn't want to press the button.</p>
      </Fragment>
      <Fragment slot="margin">
        <div style="transform:rotate(1deg);font-family:var(--font-hand);font-weight:300;color:var(--pencil);font-size:19px;line-height:1.45">Six is small. I knew it. But it was enough to show the question was wrong.</div>
      </Fragment>
    </SectionRow>

    <!-- pull quote row: empty gutter -->
    <section class="cs-row" style="padding-bottom:96px">
      <div></div>
      <figure style="margin:0;padding:24px 0">
        <blockquote style="margin:0;font-size:40px;line-height:1.22;font-style:italic;font-weight:300;letter-spacing:-0.01em;border:none;padding:0;color:var(--ink);font-family:var(--font-serif);font-variation-settings:'opsz' 40,'wght' 300">&ldquo;I know how to click the button. I just don&rsquo;t want what&rsquo;s in here to look like my final opinion.&rdquo;</blockquote>
        <figcaption class="mono" style="margin-top:22px">Postdoc, structural biology</figcaption>
      </figure>
      <aside class="sw-note" style="padding-top:30px">
        <Tally count={3} />
        <div class="note" style="margin-top:6px">3 of 6 said &ldquo;it&rsquo;s not ready yet&rdquo; without being asked.</div>
      </aside>
    </section>

    <!-- 03 insight -->
    <InsightLine
      num="03"
      label="the turn"
      validated="Validated in 6 of 6 interviews"
      observed="Observed in usage logs"
      assumed="Assumed: true outside this lab"
    >
      The interface wasn&rsquo;t the barrier. <em style="font-weight:300">The social contract was.</em> Sharing meant committing to an opinion in front of colleagues.
    </InsightLine>

    <!-- 04 fork -->
    <Fork
      num="04"
      label="the decision"
      context="The dialog barely changed. I had four explanations for why sharing was low, and I needed to pick one."
      options={[
        { label: "Fix the sharing dialog — it's confusing.", pathNotTaken: "Nobody filed tickets. Confused users usually do." },
        { label: "Reframe the action: request feedback instead of share.", pathNotTaken: "Softer framing, same social risk." },
        { label: "Add a draft mode — share before it's final.", chosen: true },
        { label: "Interview people who already share.", pathNotTaken: "I should have done this. I didn't. See below." },
      ]}
      rationale="The behavior wasn't confusion — it was a social contract problem. Opening the dialog 1.2 times and closing it isn't confusion; confused people file tickets. The real block was committing to an opinion in public before it felt finished."
      knew={[
        { text: "1.2 dialog opens per user, almost no sends. Observed in usage logs.", confidence: "observed" },
        { text: "No support tickets about the dialog. Observed.", confidence: "observed" },
        { text: "Researchers understood the UI when asked. Validated in 6 of 6 interviews.", confidence: "validated" },
        { text: "Draft framing would change the social meaning. Assumed, not yet tested.", confidence: "assumed" },
      ]}
        />

    <!-- 05 versions -->
    <Versions
      num="05"
      label="versions"
      defaultIdx={3}
      versions={[
        { name: 'v0', when: 'week 3', text: "The obvious fix: a cleaner dialog. Tested with two people, and both said 'it's fine, I just wouldn't send it.'", note: 'Built this to prove myself wrong. It worked.' },
        { name: 'v1', when: 'week 5', text: "A 'draft' toggle in the dialog. Nobody noticed it.", note: "Too quiet. A safety net nobody can see doesn't help." },
        { name: 'v2', when: 'week 8', text: "'Share as draft' becomes the default button, with 'Share final' secondary.", note: 'Flipping the default did more than any copy change.' },
        { name: 'v3', when: 'week 12', text: 'Drafts carry a visible tag and invite comments rather than approval.', note: 'Shipped. The tag says "thinking out loud."' }
      ]}
    />

    <!-- 06 outcome -->
    <SectionRow num="06" label="what happened" pb="104px">
      <Fragment slot="main">
        <OutcomeStats stats={[
          { number: "2.8×", label: "more ideas shared in the first month" },
          { number: "61%", label: "of shares went out as drafts" },
          { number: "0", label: "changes to the share dialog itself" }
        ]} />
      </Fragment>
      <Fragment slot="margin">
        <div style="transform:rotate(1.2deg);font-family:var(--font-hand);font-weight:300;color:var(--pencil);font-size:19px;line-height:1.45">The honest part: senior researchers barely changed. Drafts worked for people who felt they had something to lose. I hadn&rsquo;t planned for the people who didn&rsquo;t.</div>
      </Fragment>
    </SectionRow>

    <!-- 07 reflection -->
    <Reflection num="07" label="if again">
      Next time I&rsquo;d interview the people who already share, not just the ones who don&rsquo;t. The answer was hiding with them.
    </Reflection>

    <!-- footer -->
    <footer class="cs-row" style="align-items:end;padding-top:40px">
      <div></div>
      <a href="#" style="text-decoration:none;color:var(--ink);display:block">
        <div class="mono" style="margin-bottom:10px">Next entry &rarr;</div>
        <div style="font-size:30px;line-height:1.2;font-family:var(--font-serif)">[Next case study: the question it turned out to be]</div>
      </a>
      <p class="note sw-note" style="margin:0;font-size:16px;color:#66625A">p.s. [a true aside: what you were listening to, or the mug this was written over]</p>
    </footer>

  </div>
</Base>
