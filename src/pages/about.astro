---
import Base from '../layouts/Base.astro';
import CaseStudyHeader from '../components/notebook/CaseStudyHeader.astro';
---

<Base title="About · VK">
  <div style="background: var(--paper); min-height: 100vh; color: var(--ink); padding-bottom: 120px">

    <CaseStudyHeader entryNum="" />

    <!-- Intro -->
    <section class="cs-row" style="padding-top: 64px; padding-bottom: 72px; align-items: start">
      <div></div>
      <div>
        <h1 class="about-name">Varrshitha Kumar</h1>
        <p class="about-bio">
          I'm a product manager and designer studying at Carnegie Mellon. I work at the
          intersection of AI, product, and research — most interested in what happens when
          systems designed for experts end up in front of everyone else.
        </p>
        <p class="about-bio">
          Three things run through most of my work: finding the real problem under the stated
          one, designing AI that people can trust and correct, and meeting non-experts where
          they actually are.
        </p>
      </div>
      <aside class="sw-note" style="padding-top: 8px">
        <p class="note" style="margin:0; transform:rotate(-1deg)">
          the throughlines weren't planned. they showed up after I looked at what the work
          kept returning to.
        </p>
      </aside>
    </section>

    <!-- Timeline -->
    <div class="cs-row" style="padding-bottom: 20px">
      <div></div>
      <p class="section-label mono">Experience</p>
    </div>

    <div class="timeline">

      <div class="cs-row tl-row">
        <span class="tl-year mono">2026</span>
        <div class="tl-body">
          <div class="tl-role">Product Management Intern</div>
          <div class="tl-context mono">U.S. Bank · AI Center of Excellence · Summer 2026</div>
          <p class="tl-desc">
            Redesigned how teams request AI work — from a confusing form to a cited chatbot
            to a centralized platform with an intake agent. Ran a gamified workshop that produced
            the AI reuse roadmap, presented to senior leadership.
          </p>
        </div>
        <aside class="sw-note tl-note">
          <p class="note" style="margin:0; transform:rotate(0.8deg); font-size:16px">
            the turn: reuse was a documentation problem, not a search problem.
          </p>
        </aside>
      </div>

      <div class="cs-row tl-row">
        <span class="tl-year mono">2026</span>
        <div class="tl-body">
          <div class="tl-role">Product and UX</div>
          <div class="tl-context mono">WorkBench HR · Spring 2026</div>
          <p class="tl-desc">
            Zero-to-one AI HR product for a startup founder. Feature prioritization from scratch,
            core screen design, front-end build, and pitch assembly. The chatbot was designed into
            every mockup and built in none of them — the prototype proved the vision without the
            most expensive part.
          </p>
        </div>
        <aside class="sw-note tl-note">
          <p class="note" style="margin:0; transform:rotate(-0.6deg); font-size:16px">
            designed the whole vision. built only what proved it.
          </p>
        </aside>
      </div>

      <div class="cs-row tl-row">
        <span class="tl-year mono">2026</span>
        <div class="tl-body">
          <div class="tl-role">Project Lead</div>
          <div class="tl-context mono">Halo · CMU UCRE · Spring 2026</div>
          <p class="tl-desc">
            Led a team of four building a bias-awareness companion for AI design tools. Users
            don't look for bias while generating, so Halo comes to them: a Setup step, a Nudge
            before generation, a Flag after. Presented at the UCRE research showcase.
          </p>
        </div>
        <div></div>
      </div>

      <div class="cs-row tl-row">
        <span class="tl-year mono">2025–26</span>
        <div class="tl-body">
          <div class="tl-role">Director of Publicity</div>
          <div class="tl-context mono">Women in Product at CMU · Apr 2025 – May 2026</div>
          <p class="tl-desc">
            Created the org's visual identity, ran social media and campus marketing, and built
            a temporary website. Logo designed from the start to feel inclusive — no pink,
            no single silhouette.
          </p>
        </div>
        <div></div>
      </div>

      <div class="cs-row tl-row">
        <span class="tl-year mono">2025–26</span>
        <div class="tl-body">
          <div class="tl-role">UX Research and Design</div>
          <div class="tl-context mono">Design for America × Girls on the Run · 2025–26</div>
          <p class="tl-desc">
            Diagnosed why coach recruitment wasn't working: the posters sold low time commitment,
            but coaches stay for the girls. Redesigned the materials around the actual motivator.
          </p>
        </div>
        <div></div>
      </div>

      <div class="cs-row tl-row">
        <span class="tl-year mono">2026</span>
        <div class="tl-body">
          <div class="tl-role">Product Strategy</div>
          <div class="tl-context mono">BTG Product Management Academy · Spring 2026</div>
          <p class="tl-desc">
            Pitched a product strategy for Depop to PNC leaders and CMU Tepper faculty: in-person
            pop-up events integrated into the app, all transactions on-platform. The real design
            challenge was keeping sales from leaving Depop entirely.
          </p>
        </div>
        <div></div>
      </div>

      <div class="cs-row tl-row">
        <span class="tl-year mono">2025</span>
        <div class="tl-body">
          <div class="tl-role">Product Intern</div>
          <div class="tl-context mono">Biomotivate · Summer 2025</div>
          <p class="tl-desc">
            Hired to fix the interface of a VR therapy platform at an addiction recovery house.
            Found that patients had stopped finding anything worth watching. Rebuilt the content
            experience around what actually mattered to them.
          </p>
        </div>
        <aside class="sw-note tl-note">
          <p class="note" style="margin:0; transform:rotate(0.5deg); font-size:16px">
            I wouldn't have noticed the content problem if I'd just fixed the interface.
          </p>
        </aside>
      </div>

      <div class="cs-row tl-row">
        <span class="tl-year mono">2023–25</span>
        <div class="tl-body">
          <div class="tl-role">Design Director</div>
          <div class="tl-context mono">CMU Data Science Club · Dec 2023 – Dec 2025</div>
          <p class="tl-desc">
            Two years building the club's visual identity: logo, mascots, event graphics, and
            the website for CMU's first Poker AI competition, backed by Jane Street, HRT, and Jump
            Trading. The 2025 board built directly on the site.
          </p>
        </div>
        <div></div>
      </div>

    </div>

    <!-- Contact -->
    <div class="cs-row" style="padding-top: 72px">
      <div></div>
      <div class="contact-block">
        <p class="section-label mono" style="margin-bottom: 20px">Contact</p>
        <div class="contact-links">
          <a class="contact-link" href="mailto:varrshik@andrew.cmu.edu">varrshik@andrew.cmu.edu</a>
          <a class="contact-link" href="https://www.linkedin.com/in/varrkumar/" target="_blank" rel="noopener">LinkedIn →</a>
        </div>
      </div>
    </div>

    <footer class="cs-row" style="padding-top: 48px; align-items: end">
      <div></div>
      <a href="/" class="back mono">← Home</a>
    </footer>

  </div>
</Base>

<style>
  .about-name {
    font-family: var(--font-serif);
    font-size: 44px;
    font-style: italic;
    font-variation-settings: 'opsz' 44, 'wght' 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 28px;
    max-width: none;
  }
  .about-bio {
    font-family: var(--font-serif);
    font-size: 19px;
    font-variation-settings: 'opsz' 19, 'wght' 400;
    line-height: 1.6;
    color: var(--ink);
    margin: 0 0 16px;
    max-width: 54ch;
  }
  .about-bio:last-child { margin-bottom: 0; }

  .section-label {
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--ink-40);
    margin: 0;
    max-width: none;
  }

  /* Timeline */
  .timeline {
    border-top: 1px solid var(--ink-10);
  }
  .tl-row {
    padding-top: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--ink-10);
    align-items: start;
  }
  .tl-year {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-40);
    padding-top: 4px;
  }
  .tl-body {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .tl-role {
    font-family: var(--font-serif);
    font-size: 20px;
    font-variation-settings: 'opsz' 20, 'wght' 400;
    line-height: 1.2;
  }
  .tl-context {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-40);
    margin-bottom: 8px;
  }
  .tl-desc {
    font-family: var(--font-serif);
    font-size: 15px;
    font-variation-settings: 'opsz' 15, 'wght' 400;
    line-height: 1.6;
    color: var(--ink-60);
    margin: 0;
    max-width: 54ch;
  }
  .tl-note {
    padding-top: 4px;
  }

  /* Contact */
  .contact-links {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
  }
  .contact-link {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--ink-60);
    text-decoration: none;
  }
  .contact-link:hover { color: var(--ink); }

  .back { color: var(--ink-60); text-decoration: none; font-size: 13px; }
  .back:hover { color: var(--ink); }

  @media (max-width: 1000px) {
    .about-name { font-size: 32px; }
    .tl-year { font-size: 10px; }
  }
</style>
