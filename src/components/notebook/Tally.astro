---
/*
 * <Tally count={3} /> — hand-drawn wavy SVG tally marks, groups of 5.
 * Drawn in --pencil color. Used in pull-quote margins.
 */
interface Props {
  count: number;
}
const { count } = Astro.props;

// Each wavy mark is a cubic bezier vertical, height 46, spaced 14px
// Groups of 5: 4 verticals + 1 diagonal through them
const H = 46;
const spacing = 14;
const groupGap = 20; // extra gap between groups

interface Segment {
  d: string;
  isDiag?: boolean;
}

const segs: Segment[] = [];
let x = 10;

const full = Math.floor(count / 5);
const rem = count % 5;

function wavyVertical(cx: number, idx: number): string {
  // Alternate the wobble direction slightly based on idx
  const a = idx % 2 === 0 ? 1 : -1;
  return `M${cx},4 C ${cx + a},16 ${cx - a},30 ${cx + a},42`;
}

for (let g = 0; g < full; g++) {
  const groupStartX = x;
  const marks: number[] = [];
  for (let i = 0; i < 4; i++) {
    segs.push({ d: wavyVertical(x, i) });
    marks.push(x);
    x += spacing;
  }
  // Last mark of the group
  segs.push({ d: wavyVertical(x, 4) });
  marks.push(x);
  // Diagonal strikethrough across all 5
  segs.push({ isDiag: true, d: `M${groupStartX - 4},${H - 4} C ${groupStartX + 10},${H / 2} ${x - 10},${H / 2} ${x + 4},4` });
  x += groupGap;
}

for (let i = 0; i < rem; i++) {
  segs.push({ d: wavyVertical(x, i) });
  x += spacing;
}

const viewW = x + 4;
---

<svg
  class="tally"
  width={viewW}
  height={H + 4}
  viewBox={`0 0 ${viewW} ${H + 4}`}
  aria-label={`${count} tally marks`}
  role="img"
>
  {segs.map(seg => (
    <path
      d={seg.d}
      fill="none"
      stroke="#2D45B8"
      stroke-width="2"
      stroke-linecap="round"
    />
  ))}
</svg>

<style>
  .tally {
    display: block;
  }
</style>
