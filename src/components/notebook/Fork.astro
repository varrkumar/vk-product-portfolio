---
/*
 * <Fork> — static decision display.
 * Chosen:  hand-drawn circle overlay (sw-mark) + "what I chose" label (sw-note).
 * Rejected: always-visible wavy SVG strikethrough in pencil-blue; on hover the
 *           strike fades to 12% and the text turns ink so it reads cleanly.
 *           "path not taken" note (sw-note) expands when notes turn on.
 * Margin:  "What I knew at the time" list with ●◐○ confidence markers (sw-note).
 */
interface ForkOption {
  label: string;
  chosen?: boolean;
  pathNotTaken?: string;
}
interface KnewItem {
  text: string;
  confidence: 'validated' | 'observed' | 'assumed';
}
interface Props {
  num?: string;
  label?: string;
  context?: string;
  options: ForkOption[];
  rationale?: string;
  knew?: KnewItem[];
}

const { num, label, context, options, rationale, knew } = Astro.props;
const sectionId = num ? `section-${num.replace(/\s/g, '-')}` : undefined;
---

<section
  class="cs-row fork"
  style="padding-bottom: 88px; scroll-margin-top: 120px"
  id={sectionId}
  data-section-num={num}
  data-section-label={label}
>
  <div class="cs-gutter" style="padding-top: 6px">
    {num   && <div class="mono">{num}</div>}
    {label && <div class="hand" style="font-size:20px;color:#66625A;transform:rotate(-2deg);margin-top:4px">{label}</div>}
  </div>

  <div>
    {context && <p class="fork-context">{context}</p>}

    <ul class="fork-options" role="list">
      {options.map((opt, i) => (
        <li class={`fork-option ${opt.chosen ? 'fork-option--chosen' : 'fork-option--rejected'}`}>
          <span class="fork-letter mono">{String.fromCharCode(65 + i)}</span>
          <div class="fork-main">

            <span class={`fork-text-wrap${opt.chosen ? ' fork-chosen-wrap' : ''}`}>
              <span class="fork-text">{opt.label}</span>

              {/* Chosen: hand-drawn circle (sw-mark — visible when notes on) */}
              {opt.chosen && (
                <svg
                  class="fork-circle sw-mark"
                  viewBox="0 0 220 60"
                  fill="none"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                >
                  <path
                    class="fork-circle-path"
                    d="M 12,30 C 14,12 42,5 110,5 C 178,5 208,12 208,30 C 208,48 178,55 110,55 C 42,55 14,48 12,30"
                    stroke="#2D45B8"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    fill="none"
                    stroke-dasharray="420"
                    stroke-dashoffset="420"
                  />
                </svg>
              )}

              {/* Rejected: always-visible wavy SVG strikethrough */}
              {!opt.chosen && (
                <svg
                  class="fork-strike"
                  viewBox="0 0 400 20"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                >
                  <path
                    d="M0,10 C22,7 44,13 66,10 C88,7 110,13 132,10 C154,7 176,13 198,10 C220,7 242,13 264,10 C286,7 308,13 330,10 C352,7 374,13 396,10"
                    stroke="#2D45B8"
                    stroke-width="1.8"
                    fill="none"
                    stroke-linecap="round"
                    vector-effect="non-scaling-stroke"
                  />
                </svg>
              )}
            </span>

            {/* "what I chose" label — sw-note */}
            {opt.chosen && (
              <span class="fork-chosen-label sw-note hand">what I chose</span>
            )}

            {/* "path not taken" note — sw-note, max-height expand */}
            {!opt.chosen && opt.pathNotTaken && (
              <div class="fork-path sw-note">{`path not taken: ${opt.pathNotTaken}`}</div>
            )}
          </div>
        </li>
      ))}
    </ul>

    {rationale && <p class="fork-rationale">{rationale}</p>}
  </div>

  {knew && knew.length > 0 && (
    <aside class="cs-margin sw-note fork-knew">
      <div class="fork-knew-label mono">What I knew at the time</div>
      <ul class="fork-knew-list" role="list">
        {knew.map(item => (
          <li class="fork-knew-item">
            {item.confidence === 'validated' && (
              <svg aria-hidden="true" width="10" height="10" viewBox="0 0 12 12" style="flex-shrink:0;margin-top:3px">
                <circle cx="6" cy="6" r="5" fill="#1C1B18" />
              </svg>
            )}
            {item.confidence === 'observed' && (
              <svg aria-hidden="true" width="10" height="10" viewBox="0 0 12 12" style="flex-shrink:0;margin-top:3px">
                <circle cx="6" cy="6" r="5" fill="none" stroke="#1C1B18" stroke-width="1.2" />
                <path d="M6,1 A5,5 0 0 1 6,11 Z" fill="#1C1B18" />
              </svg>
            )}
            {item.confidence === 'assumed' && (
              <svg aria-hidden="true" width="10" height="10" viewBox="0 0 12 12" style="flex-shrink:0;margin-top:3px">
                <circle cx="6" cy="6" r="5" fill="none" stroke="#1C1B18" stroke-width="1.2" />
              </svg>
            )}
            <span>{item.text}</span>
          </li>
        ))}
      </ul>
    </aside>
  )}
</section>

<style>
  .fork-context {
    font-family: var(--font-serif);
    font-size: 21px;
    line-height: 1.62;
    margin: 0 0 32px;
    font-variation-settings: 'opsz' 20, 'wght' 400;
  }

  .fork-options {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
  }

  .fork-option {
    display: grid;
    grid-template-columns: 2.2em 1fr;
    padding: 16px 0;
    border-top: var(--border-hairline);
    align-items: start;
  }
  .fork-option:last-child { border-bottom: var(--border-hairline); }

  .fork-letter {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--ink-40);
    padding-top: 0.25em;
  }

  .fork-main {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .fork-text-wrap {
    position: relative;
    display: inline-block;
  }

  .fork-text {
    font-family: var(--font-serif);
    font-size: 21px;
    line-height: 1.4;
    font-variation-settings: 'opsz' 20, 'wght' 400;
  }
  .fork-option--chosen .fork-text {
    font-variation-settings: 'opsz' 20, 'wght' 500;
    color: var(--ink);
  }
  .fork-option--rejected .fork-text {
    color: var(--ink-60);
    transition: color .2s ease;
  }

  /* Wavy SVG strikethrough — always visible on rejected options */
  .fork-strike {
    position: absolute;
    left: -2px;
    right: -2px;
    top: 50%;
    transform: translateY(-50%);
    width: calc(100% + 4px);
    height: 20px;
    pointer-events: none;
    overflow: visible;
  }
  .fork-strike path {
    stroke-opacity: 1;
    transition: stroke-opacity .2s ease;
  }

  /* Hover: fade strike, reveal readable text */
  .fork-option--rejected:hover .fork-strike path,
  .fork-option--rejected:focus-within .fork-strike path {
    stroke-opacity: 0.12;
  }
  .fork-option--rejected:hover .fork-text,
  .fork-option--rejected:focus-within .fork-text {
    color: var(--ink);
  }

  /* Chosen circle overlay */
  .fork-circle {
    position: absolute;
    inset: -10px -14px;
    width: calc(100% + 28px);
    height: calc(100% + 20px);
    pointer-events: none;
    overflow: visible;
  }

  .fork-chosen-label {
    font-family: var(--font-hand);
    font-size: 15px;
    color: var(--pencil);
    transform: rotate(-1deg);
    display: inline-block;
  }

  /* Path-not-taken note: collapses/expands via JS max-height */
  .fork-path {
    font-family: var(--font-hand);
    font-size: 15px;
    color: var(--pencil);
    transform: rotate(-0.5deg);
    display: block;
    max-height: 0;
    overflow: hidden;
  }

  .fork-rationale {
    font-family: var(--font-serif);
    font-size: 21px;
    line-height: 1.62;
    color: var(--ink);
    margin: 0;
    font-variation-settings: 'opsz' 20, 'wght' 400;
    max-width: none;
  }

  .fork-knew { padding-top: 6px; }
  .fork-knew-label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--ink-60);
    margin-bottom: 12px;
    text-transform: uppercase;
  }
  .fork-knew-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .fork-knew-item {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.55;
    color: var(--ink-60);
  }

  @media (max-width: 1023px) {
    .fork-knew { padding-left: 16px; border-left: 1.5px solid var(--pencil); }
  }
</style>

<script>
  /* Draw hand-drawn circles on chosen options when they enter view */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const path = entry.target.querySelector<SVGPathElement>('.fork-circle-path');
      if (path) {
        if (!reduced) {
          path.style.transition = 'stroke-dashoffset 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s';
        }
        path.style.strokeDashoffset = '0';
      }
      obs.unobserve(entry.target);
    });
  }, { threshold: 0.4 });
  document.querySelectorAll<HTMLElement>('.fork-option--chosen').forEach(el => obs.observe(el));
</script>
