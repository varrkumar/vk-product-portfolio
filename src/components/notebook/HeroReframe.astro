---
/*
 * <HeroReframe> — the case study hero.
 * The brief I was handed (grey, readable, not crossed out: it wasn't wrong,
 * it just wasn't the whole problem) → a hand-drawn pencil arrow → the
 * question it turned out to be (large).
 * Role / timeline / team sit in the margin as a handwritten note.
 */
interface Props {
  original: string;          // the brief as given
  reframed: string;          // the real question
  entryNum?: string;
  handedLabel?: string;
  reframedLabel?: string;
  marginNote?: string;       // sentences separated by ". " become lines
  marginSub?: string;
}
const {
  original,
  reframed,
  entryNum = '',
  handedLabel = 'What I was handed',
  reframedLabel = 'The question it turned out to be',
  marginNote = '',
  marginSub = '',
} = Astro.props;
---

<section class="cs-row hero" style="padding-top: 64px; padding-bottom: 104px">
  <div class="cs-gutter" style="padding-top: 6px">
    {entryNum && <div class="mono">Entry {entryNum}</div>}
  </div>

  <div>
    <p class="mono" style="margin: 0 0 18px">{handedLabel}</p>
    <p class="hero-handed">{original}</p>

    <svg
      class="hero-arrow sw-mark"
      aria-hidden="true"
      viewBox="0 0 120 84"
      fill="none"
    >
      <path
        class="hero-arrow-path"
        d="M 14,4 C 6,30 18,58 64,70"
        stroke="#2D45B8" stroke-width="1.6" stroke-linecap="round"
      />
      <path
        class="hero-arrow-head"
        d="M 52,61 L 65,70 L 51,77"
        stroke="#2D45B8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
      />
    </svg>

    <p class="mono" style="margin: 0 0 20px">{reframedLabel}</p>
    <h1 class="hero-q">{reframed}</h1>
  </div>

  {(marginNote || marginSub) && (
    <aside class="cs-margin sw-note" style="padding-top: 6px">
      {marginNote && (
        <div class="note" style="transform: rotate(-1.2deg)">
          <span set:html={marginNote.replace(/\. /g, '.<br>')} />
        </div>
      )}
      {marginSub && (
        <div class="hand" style="margin-top: 26px; transform: rotate(0.6deg); color: #66625A; font-size: 17px">{marginSub}</div>
      )}
    </aside>
  )}
</section>

<style>
  .hero-handed {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 30px;
    line-height: 1.3;
    color: var(--ink-60);
    font-variation-settings: 'opsz' 30, 'wght' 400;
    max-width: none;
  }

  .hero-arrow {
    display: block;
    width: 96px;
    height: 68px;
    margin: 14px 0 18px 4px;
    overflow: visible;
  }

  /* Without the pencil layer, keep the rhythm: the gap stays, the arrow fades. */
  .hero-arrow-path {
    stroke-dasharray: 90;
    stroke-dashoffset: 90;
    animation: hero-draw 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
  }
  .hero-arrow-head {
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
    animation: hero-draw 0.35s ease-out 1.25s forwards;
  }
  @keyframes hero-draw { to { stroke-dashoffset: 0; } }

  .hero-q {
    margin: 0;
    font-weight: 400;
    font-size: 62px;
    line-height: 1.06;
    letter-spacing: -0.015em;
    font-family: var(--font-serif);
    font-variation-settings: 'opsz' 62, 'wght' 400;
    text-wrap: balance;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-arrow-path, .hero-arrow-head { animation: none; stroke-dashoffset: 0; }
  }

  @media (max-width: 1000px) {
    .hero-handed { font-size: 24px; }
    .hero-q { font-size: 42px; }
  }
</style>
