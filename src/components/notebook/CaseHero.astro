---
/*
 * <CaseHero> — a traditional case study hero, notebook-styled.
 * Eyebrow (company · context), title, one-line summary, a facts row
 * (role, timeline, team, focus, results), then a wide cover image.
 * A handwritten margin note (show-your-work) can carry the reframe.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Meta { label: string; value: string; }
interface Props {
  title: string;
  lede: string;
  eyebrow?: string;
  entryNum?: string;
  meta?: Meta[];
  cover?: ImageMetadata;
  coverAlt?: string;
  note?: string;
}
const { title, lede, eyebrow = '', entryNum = '', meta = [], cover, coverAlt = '', note = '' } = Astro.props;
---

<section class="cs-row hero" style="padding-top: 56px; padding-bottom: 40px">
  <div class="cs-gutter" style="padding-top: 6px">
    {entryNum && <div class="mono">Entry {entryNum}</div>}
  </div>

  <div>
    {eyebrow && <p class="mono" style="margin: 0 0 22px">{eyebrow}</p>}
    <h1 class="hero-title">{title}</h1>
    <p class="hero-lede">{lede}</p>
  </div>

  <aside class="cs-margin sw-note" style="padding-top: 40px">
    {note && <p class="note" style="margin: 0; transform: rotate(-1.2deg)" set:html={note} />}
  </aside>
</section>

{meta.length > 0 && (
  <section class="cs-row" style="padding-bottom: 48px">
    <div></div>
    <dl class="hero-meta cs-wide">
      {meta.map(m => (
        <div class="hero-meta-item">
          <dt class="mono">{m.label}</dt>
          <dd>{m.value}</dd>
        </div>
      ))}
    </dl>
  </section>
)}

{cover && (
  <section class="cs-row" style="padding-bottom: 112px">
    <div></div>
    <div class="cs-wide">
      <Image
        src={cover}
        alt={coverAlt}
        widths={[640, 1280, 1920]}
        sizes="(max-width: 1000px) 100vw, 990px"
        loading="eager"
        class="hero-cover"
      />
    </div>
  </section>
)}

<style>
  .hero-title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 64px;
    line-height: 1.04;
    letter-spacing: -0.018em;
    font-variation-settings: 'opsz' 64, 'wght' 400;
    text-wrap: balance;
  }
  .hero-lede {
    margin: 28px 0 0;
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.5;
    color: var(--ink-60);
    font-variation-settings: 'opsz' 24, 'wght' 400;
    max-width: none;
    text-wrap: pretty;
  }
  .hero-meta {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(var(--meta-cols, 5), minmax(0, 1fr));
    gap: 28px;
    padding-top: 22px;
    border-top: var(--border-hairline);
  }
  .hero-meta-item dt { margin-bottom: 8px; }
  .hero-meta-item dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.45;
    font-variation-settings: 'opsz' 17, 'wght' 400;
  }
  .hero-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    object-position: center top;
    border: var(--border-hairline);
  }
  @media (max-width: 1000px) {
    .hero-title { font-size: 42px; }
    .hero-lede { font-size: 20px; }
    .hero-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
    .hero-cover { aspect-ratio: 16 / 9; }
  }
</style>
