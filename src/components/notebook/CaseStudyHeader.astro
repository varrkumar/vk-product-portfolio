---
import Wordmark from '../Wordmark.astro';
interface Props {
  entryNum?: string;
}
const { entryNum = '' } = Astro.props;
---

<header class="cs-row" style="padding-top: 36px; padding-bottom: 36px; align-items: center">
  <a href="/" style="text-decoration: none; color: var(--ink)"><Wordmark /></a>
  <nav aria-label="Main" style="display: flex; gap: 32px; align-items: center">
    <a class="mono" href="/work"     style="color: var(--ink); text-decoration: none">Work</a>
    <a class="mono" href="/projects" style="text-decoration: none">Projects</a>
    <a class="mono" href="/design"   style="text-decoration: none">Design</a>
    <a class="mono" href="/about"    style="text-decoration: none">About</a>
  </nav>
  <div></div>
</header>
